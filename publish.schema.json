{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Vadagon/cwsagent/main/publish.schema.json",
  "title": "CWSAgent meta/store/publish.json",
  "description": "Everything CWSAgent needs to fill the Chrome Web Store console and Microsoft Edge Partner Center from a META.md meta/ folder. Generated by scripts/publish-manifest.mjs. Paths are relative to meta/. See README.md, "Both stores from a meta/ folder".",
  "type": "object",
  "required": ["format"],
  "properties": {
    "$schema": { "type": "string" },
    "format": { "const": 1 },
    "generatedAt": { "type": "string" },
    "generatedBy": { "type": "string" },
    "extension": { "description": "Display name for the panel.", "type": "string" },
    "package": {
      "type": "object",
      "properties": {
        "zip": { "description": "Release ZIP copied into meta/ (gitignored), uploaded on Edge's Packages page.", "type": "string" },
        "source": { "description": "Where the ZIP was copied from.", "type": "string" },
        "version": { "type": "string" },
        "defaultLocale": { "type": "string" },
        "locales": { "description": "_locales folders in the ZIP: the only languages either store offers.", "type": "array", "items": { "type": "string" } }
      }
    },
    "stores": {
      "type": "object",
      "properties": {
        "chrome": {
          "type": "object",
          "properties": {
            "itemId": { "type": "string", "pattern": "^[a-p]{32}$" },
            "publisherId": { "type": "string" },
            "editUrl": { "type": "string", "format": "uri" }
          }
        },
        "edge": {
          "type": "object",
          "properties": {
            "productId": { "type": "string" },
            "listingsUrl": { "type": "string", "format": "uri" }
          }
        }
      }
    },
    "details": {
      "type": "object",
      "properties": {
        "category": { "description": "Chrome console label (\"Social Networking\").", "type": "string" },
        "edgeCategory": { "description": "Partner Center category label (\"Social\").", "type": "string" },
        "officialUrl": { "type": "string" },
        "homepageUrl": { "type": "string", "format": "uri" },
        "supportUrl": { "type": "string", "format": "uri" },
        "matureContent": { "type": "boolean" },
        "promoVideo": { "type": "string", "format": "uri" }
      }
    },
    "privacy": {
      "type": "object",
      "properties": {
        "singlePurpose": { "type": "string" },
        "permissions": { "description": "Justification per manifest permission name.", "type": "object", "additionalProperties": { "type": "string" } },
        "hostPermission": { "description": "One text for all host permissions and content-script matches.", "type": "string" },
        "remoteCode": { "type": "boolean" },
        "remoteCodeJustification": { "type": "string" },
        "dataCollected": {
          "type": "array",
          "items": { "enum": ["pii", "health", "financial", "authentication", "communications", "location", "webHistory", "userActivity", "websiteContent"] }
        },
        "privacyPolicyUrl": { "type": "string", "format": "uri" }
      }
    },
    "testInstructions": {
      "type": "object",
      "properties": {
        "username": { "type": "string" },
        "instructions": { "type": "string", "maxLength": 500 }
      }
    },
    "images": {
      "type": "object",
      "properties": {
        "icon": { "description": "128×128; usually left out so the console keeps its icon.", "type": "string" },
        "smallTile": { "description": "440×280.", "type": "string" },
        "marquee": { "description": "1400×560.", "type": "string" },
        "edgeLogo": { "description": "300×300, Edge only.", "type": "string" },
        "screenshots": { "description": "Global set, 1280×800, up to 5.", "type": "array", "items": { "type": "string" } }
      }
    },
    "languages": {
      "description": "Keyed by Chrome _locales code (pt_BR).",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "chrome": { "description": "Value in the console's language picker (pt-BR, iw).", "type": "string" },
          "edge": { "description": "Partner Center's language name (Portuguese (Brazil)).", "type": "string" },
          "inPackage": { "description": "false: the ZIP lacks this locale, so neither store offers it; CWSAgent skips it.", "type": ["boolean", "null"] },
          "description": { "type": "string" },
          "screenshots": { "type": "array", "items": { "type": "string" } },
          "promoVideo": { "type": "string", "format": "uri" },
          "searchTerms": { "description": "Edge: up to 7, each ≤ 30 characters, ≤ 21 words in all.", "type": "array", "maxItems": 7, "items": { "type": "string", "maxLength": 30 } }
        }
      }
    },
    "manual": {
      "description": "Steps the owner does by hand.",
      "type": "array",
      "items": { "type": "object", "properties": { "store": { "enum": ["chrome", "edge"] }, "step": { "type": "string" } } }
    },
    "review": { "description": "Answers the generator inferred or could not map; confirm before saving.", "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } }
  }
}
